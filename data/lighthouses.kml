		<SimpleData name="transcribed">1</SimpleData>
		<SimpleData name="ledger_issues">(3:Characteristic 'Fl W 15 Sec (10+5=15 Sec)' with Duration of Flash 10 Sec - light longer than eclipse, inconsistent with a flashing light,Tower height 34 M exceeds stated elevation 33 M,NAIS section has date and router/antenna but no base station model or MMSI)</SimpleData>
		<SimpleData name="equip_years">{ &quot;racon&quot;: 2016, &quot;ais&quot;: 2012 }</SimpleData>
		<SimpleData name="equip_since">{ &quot;navtex&quot;: { &quot;year&quot;: 2015, &quot;src&quot;: &quot;network&quot; }, &quot;racon&quot;: { &quot;year&quot;: 2016, &quot;src&quot;: &quot;ledger&quot; }, &quot;ais&quot;: { &quot;year&quot;: 2012, &quot;src&quot;: &quot;ledger&quot; } }</SimpleData>
