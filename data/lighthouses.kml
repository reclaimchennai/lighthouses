		<SimpleData name="dgps">0</SimpleData>
		<SimpleData name="vts">0</SimpleData>
		<SimpleData name="tower_type">R.C.C. Square tower</SimpleData>
		<SimpleData name="tower_h_m">19.8</SimpleData>
		<SimpleData name="tower_colour">Black and White Bands (Band width 3.84m, Bottom band Black, No. of bands 5)</SimpleData>
		<SimpleData name="tower_year">1958</SimpleData>
		<SimpleData name="established">1873</SimpleData>
		<SimpleData name="visit">grounds</SimpleData>
		<SimpleData name="tourism">0</SimpleData>
