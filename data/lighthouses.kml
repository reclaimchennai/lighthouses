		<SimpleData name="tower_type">Brick Masonry circular Tower</SimpleData>
		<SimpleData name="tower_h_m">27</SimpleData>
		<SimpleData name="tower_colour">3 Black and 2 White bands (Bottom band Black)</SimpleData>
		<SimpleData name="tower_year">1865</SimpleData>
