		<SimpleData name="vts">0</SimpleData>
		<SimpleData name="tower_type">Circular masonry tower</SimpleData>
		<SimpleData name="tower_h_m">24</SimpleData>
		<SimpleData name="tower_colour">Black and White alternate horizontal bands</SimpleData>
		<SimpleData name="tower_year">1958</SimpleData>
		<SimpleData name="established">1898</SimpleData>
		<SimpleData name="visit">closed</SimpleData>
		<SimpleData name="tourism">0</SimpleData>
		<SimpleData name="museum">0</SimpleData>
		<SimpleData name="record">1</SimpleData>
		<SimpleData name="ledger_url">https://www.dgll.nic.in/sites/default/files/2022-12/Master%20Ledger%20Gandhidham%2017.pdf</SimpleData>
		<SimpleData name="page_url">https://www.dgll.nic.in/DGLL-light-house-location/about-vts-gandhi-dham/pirotan-lighthouse</SimpleData>
		<SimpleData name="rowlett">1958 (station established 1898). Active; focal plane 26 m (85 ft); white flash every 20 s. 21 m (69 ft) round masonry tower with lantern and gallery, painted with horizontal black and white bands. Jayesh Kumar's 2020 photo is at right, Wikimedia has a sunrise photo by S. Ballal, Kumar has another 2020 photo, and Google has a satellite view. A seawall protects this highly exposed lighthouse. Pirotan is the beginning of the approach to Bedi, the seaport of the city of Jamnagar. Located on a small island 10 km (6 mi) northwest of Rozi. Accessible only by boat. Site and tower closed. ARLHS IND-157; Admiralty F0380; NGA 28352.</SimpleData>
		<SimpleData name="arlhs">IND-157</SimpleData>
		<SimpleData name="wikidata">Q29048448</SimpleData>
		<SimpleData name="photo">http://commons.wikimedia.org/wiki/Special:FilePath/Lighthouse%20pirotan.jpg</SimpleData>
		<SimpleData name="transcribed">1</SimpleData>
		<SimpleData name="ledger_issues">(4:Intensity printed as '46,0194 Candela' (irregular digit grouping, read as 460194),Duration of flash 0.7 Second differs from characteristic flash 0.4 s,2 panels at 3 RPM gives a flash every 10 s, but characteristic is every 20 s,Commissioning: first lighthouse 1898, modern lighthouse 05.02.1958)</SimpleData>
		<SimpleData name="equip_years">{ &quot;racon&quot;: 2004 }</SimpleData>
		<SimpleData name="equip_since">{ &quot;racon&quot;: { &quot;year&quot;: 2004, &quot;src&quot;: &quot;ledger&quot; } }</SimpleData>
		<SimpleData name="tenders">(0:)</SimpleData>
		<SimpleData name="photo_credit">DGLL</SimpleData>
	</SchemaData></ExtendedData>
