		<SimpleData name="reach_nm">18.7</SimpleData>
		<SimpleData name="intensity_cd">403597</SimpleData>
		<SimpleData name="elev_m">46</SimpleData>
		<SimpleData name="optic">revolving</SimpleData>
		<SimpleData name="optic_order">4</SimpleData>
		<SimpleData name="optic_evidence">300 mm (4th order large) revolving; Rotation Device: Stepper motor; R.P.M. 2</SimpleData>
		<SimpleData name="optic_make">B.B.T.</SimpleData>
		<SimpleData name="optic_type">revolving</SimpleData>
