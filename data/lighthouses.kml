  <Placemark>
	<name>Navlakhi Lighthouse</name>
	<ExtendedData><SchemaData schemaUrl="#lighthouses">
		<SimpleData name="id">navlakhi-lighthouse</SimpleData>
		<SimpleData name="kind">lighthouse</SimpleData>
		<SimpleData name="region">Gandhidham (VTS)</SimpleData>
		<SimpleData name="pos_src">DGLL ledger</SimpleData>
		<SimpleData name="alol">F 0370</SimpleData>
		<SimpleData name="char">Fl (W) 10Sec. (1 + 9 = 10Sec)</SimpleData>
		<SimpleData name="ckind">Fl</SimpleData>
		<SimpleData name="colour">W</SimpleData>
		<SimpleData name="group">1</SimpleData>
		<SimpleData name="period">10</SimpleData>
		<SimpleData name="phases">(2:1,9)</SimpleData>
		<SimpleData name="phases_src">ledger</SimpleData>
		<SimpleData name="flash_s">1</SimpleData>
		<SimpleData name="sectored">0</SimpleData>
		<SimpleData name="lum_nm">12</SimpleData>
		<SimpleData name="geo_nm">16.2</SimpleData>
		<SimpleData name="reach_nm">12</SimpleData>
		<SimpleData name="elev_m">31</SimpleData>
		<SimpleData name="optic">flasher</SimpleData>
		<SimpleData name="optic_evidence">Type of Light (LED Flasher); Lantern: 12NM MLB-200-13 marine LED lantern</SimpleData>
		<SimpleData name="optic_make">Advance Navigation and Solar Technologies, New Delhi</SimpleData>
		<SimpleData name="optic_model">MLB-200-13</SimpleData>
		<SimpleData name="optic_type">12NM marine LED lantern (LED Flasher)</SimpleData>
		<SimpleData name="led">1</SimpleData>
		<SimpleData name="solar">1</SimpleData>
		<SimpleData name="ais">0</SimpleData>
		<SimpleData name="dgps">0</SimpleData>
		<SimpleData name="racon">B</SimpleData>
		<SimpleData name="vts">0</SimpleData>
		<SimpleData name="tower_type">Circular RCC tower</SimpleData>
		<SimpleData name="tower_h_m">30</SimpleData>
		<SimpleData name="tower_colour">White and red Alternate Horizontal bands</SimpleData>
		<SimpleData name="tower_year">2012</SimpleData>
		<SimpleData name="established">1932</SimpleData>
		<SimpleData name="visit">closed</SimpleData>
		<SimpleData name="tourism">0</SimpleData>
		<SimpleData name="museum">0</SimpleData>
		<SimpleData name="record">1</SimpleData>
		<SimpleData name="ledger_url">https://www.dgll.nic.in/sites/default/files/2022-12/Master%20Ledger%20Gandhidham%2012.pdf</SimpleData>
		<SimpleData name="page_url">https://www.dgll.nic.in/DGLL-light-house-location/about-vts-gandhi-dham/navlakhi-lighthouse</SimpleData>
		<SimpleData name="rowlett">2012 (station established 1932). Active; focal plane 30 m (198 ft); three white flashes every 10 s. 30 m (98 ft) round concrete tower with lantern, gallery, and an observation level, very similar to the Bhadreswar lighthouse at right. Tower painted with horizontal red and white bands. Saiad Sekh has a 2023 photo, Rajesh Shah has a distant view, and Google has a satellite view. The light guides ships approaching the port facility at Navlakhi at the head of the Gulf of Kachchh. The original light was replaced in 1985 by a 24 m (79 ft) skeletal tower. That lighthouse was knocked out of service by the earthquake of 26 January 2001, but it was restored and returned to service the following month.</SimpleData>
		<SimpleData name="arlhs">IND-155</SimpleData>
		<SimpleData name="photo">https://www.dgll.nic.in/sites/default/files/2022-11/Navlakhi%20Lighthouse.png</SimpleData>
		<SimpleData name="transcribed">1</SimpleData>
		<SimpleData name="ledger_issues">(3:Characteristic Fl (W) 10Sec (1 + 9) conflicts with lantern character '3fl (W) every 10Sec {(0.5+1.5)2+0.5+5.5=10Sec.}',Year of Establishment '1910 and re-established in 2012',Page footer reads 'Page 2 of 8' but PDF has only 2 pages)</SimpleData>
		<SimpleData name="equip_years">{ }</SimpleData>
		<SimpleData name="equip_since">{ &quot;racon&quot;: { &quot;year&quot;: 2004, &quot;src&quot;: &quot;network&quot; } }</SimpleData>
		<SimpleData name="tenders">(1:2303)</SimpleData>
		<SimpleData name="photo_credit">DGLL</SimpleData>
	</SchemaData></ExtendedData>
      <Point><coordinates>70.4439,22.961</coordinates></Point>
  </Placemark>
  <Placemark>
	<name>Chhachhi Lighthouse And Vts Station</name>
	<ExtendedData><SchemaData schemaUrl="#lighthouses">
		<SimpleData name="id">chhachhi-lighthouse-and-vts-station</SimpleData>
		<SimpleData name="kind">lighthouse</SimpleData>
		<SimpleData name="region">Gandhidham (VTS)</SimpleData>
		<SimpleData name="pos_src">DGLL ledger</SimpleData>
		<SimpleData name="alol">F-0356</SimpleData>
		<SimpleData name="char">Fl (3)W 15 sec. [(0.35+2.15+0.35+2.15+0.35+9.65 =15 sec.)]</SimpleData>
		<SimpleData name="ckind">Fl</SimpleData>
		<SimpleData name="colour">W</SimpleData>
		<SimpleData name="group">3</SimpleData>
		<SimpleData name="period">15</SimpleData>
		<SimpleData name="phases">(6:0.35,2.15,0.35,2.15,0.35,9.65)</SimpleData>
		<SimpleData name="phases_src">ledger</SimpleData>
		<SimpleData name="flash_s">0.35</SimpleData>
		<SimpleData name="sectored">0</SimpleData>
		<SimpleData name="lum_nm">19</SimpleData>
		<SimpleData name="geo_nm">14</SimpleData>
		<SimpleData name="iala_nm">19.3</SimpleData>
		<SimpleData name="reach_nm">14</SimpleData>
		<SimpleData name="intensity_cd">85383</SimpleData>
		<SimpleData name="elev_m">32</SimpleData>
		<SimpleData name="optic">revolving</SimpleData>
		<SimpleData name="optic_order">4</SimpleData>
		<SimpleData name="optic_evidence">B.B.T. France make 250 mm (4th order large) revolving type</SimpleData>
		<SimpleData name="optic_make">B.B.T. France</SimpleData>
		<SimpleData name="optic_type">250 mm (4th order large) revolving type</SimpleData>
		<SimpleData name="optic_size">250 mm</SimpleData>
		<SimpleData name="led">1</SimpleData>
		<SimpleData name="solar">1</SimpleData>
		<SimpleData name="ais">1</SimpleData>
		<SimpleData name="dgps">0</SimpleData>
		<SimpleData name="vts">1</SimpleData>
		<SimpleData name="tower_type">Square masonry stone tower</SimpleData>
		<SimpleData name="tower_colour">3 Black and 2 white bands</SimpleData>
		<SimpleData name="tower_year">1964</SimpleData>
		<SimpleData name="established">1957</SimpleData>
		<SimpleData name="visit">grounds</SimpleData>
		<SimpleData name="tourism">0</SimpleData>
		<SimpleData name="museum">0</SimpleData>
		<SimpleData name="record">1</SimpleData>
		<SimpleData name="ledger_url">https://www.dgll.nic.in/sites/default/files/2022-12/Master%20Ledger%20Gandhidham%2005.pdf</SimpleData>
		<SimpleData name="page_url">https://www.dgll.nic.in/DGLL-light-house-location/about-vts-gandhi-dham/chhachhi-lighthouse-and-vts-station</SimpleData>
		<SimpleData name="rowlett">1964 (station established 1957). Active; focal plane 33 m (108 ft); three white flashes every 15 s. 31 m (102 ft) square cylindrical masonry tower with lantern and gallery. Lighthouse painted with horizontal black and white bands; lantern roof painted red. DGLL's photo shows the lighthouse and the much taller traffic control tower that has stood next to it since 2008. Saurabh Parmar has a 2019 photo of the two towers, Niraj Kumar also has a photo, and Google has a satellite view of the two towers. This is an important lighthouse marking the northern entrance to the Gulf of Kachchh. Located near the village of Chhachhi about 50 km (30 mi) north northwest of Mandvi. Site open, although roads i</SimpleData>
		<SimpleData name="arlhs">IND-015</SimpleData>
		<SimpleData name="photo">https://www.dgll.nic.in/sites/default/files/2022-11/Chhachhi%20Lighthouse%20And%20Vts%20Station.png</SimpleData>
		<SimpleData name="transcribed">1</SimpleData>
		<SimpleData name="ledger_issues">(3:Optic 'Duration of flash: 2.1 sec' contradicts characteristic flash length 0.35 sec,Elevation given as '27.43+4.57=32 M'; tower height not separately stated (VTS tower 60 m is a separate structure),established_year from lighthouse commissioning 15.06.1964 (VTS 13.02.2012))</SimpleData>
		<SimpleData name="equip_years">{ }</SimpleData>
		<SimpleData name="equip_since">{ &quot;ais&quot;: { &quot;year&quot;: 2012, &quot;src&quot;: &quot;network&quot; } }</SimpleData>
		<SimpleData name="tenders">(1:2303)</SimpleData>
		<SimpleData name="photo_credit">DGLL</SimpleData>
	</SchemaData></ExtendedData>
      <Point><coordinates>69.00167,22.95333</coordinates></Point>
