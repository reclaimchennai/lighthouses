		<SimpleData name="optic">revolving</SimpleData>
		<SimpleData name="optic_order">3</SimpleData>
		<SimpleData name="optic_evidence">Size: 500 mm (3rd order large) revolving type; Rotation device: stepper motor; R.P.M.: 3</SimpleData>
