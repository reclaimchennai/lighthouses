		<SimpleData name="dgps">0</SimpleData>
		<SimpleData name="vts">0</SimpleData>
		<SimpleData name="tower_type">Octagonal Masonry Tower</SimpleData>
		<SimpleData name="tower_h_m">18.3</SimpleData>
		<SimpleData name="tower_colour">Red, White &amp; Red Bands</SimpleData>
		<SimpleData name="tower_year">1964</SimpleData>
		<SimpleData name="established">1884</SimpleData>
		<SimpleData name="visit">grounds</SimpleData>
		<SimpleData name="tourism">0</SimpleData>
		<SimpleData name="museum">0</SimpleData>
		<SimpleData name="record">1</SimpleData>
		<SimpleData name="ledger_url">https://www.dgll.nic.in/sites/default/files/2022-12/mm17.pdf</SimpleData>
		<SimpleData name="page_url">https://www.dgll.nic.in/DGLL-light-house-location/about-mumbai/nanwel-point-lighthouse</SimpleData>
		<SimpleData name="rowlett">1964 (station established 1884). Active; focal plane 66 m (217 ft); three white flashes every 15 s. 19 m (62 ft) octagonal masonry tower with lantern and gallery painted with red and white horizontal bands. Prajyot Sale has the 2022 photo at right, Pritam Patil has a 2018 closeup photo, Sachchida Nand Arya has a photo, Wikimapia has photos, and Google has a satellite view. The original light was a 10.5 m (34 ft) white tower. In 1998 Nilesh Korgaonkar had a long hike from Nanvell to reach the lighthouse, where he had tea with the keepers. Located on a promontory at the southern entrance to the Rajpuri Creek estuary, about 80 km (50 mi) west of Mangaon. Site open but quite difficult to reach, </SimpleData>
		<SimpleData name="arlhs">IND-104</SimpleData>
		<SimpleData name="photo">https://www.dgll.nic.in/sites/default/files/2022-11/Nanwel%20Point%20Lighthouse.jpg</SimpleData>
		<SimpleData name="transcribed">1</SimpleData>
		<SimpleData name="ledger_issues">(5:Headline says every 15 s but itemised sequence (0.33, 12.7, 0.33, 2.17, 0.33, 9.67) sums to 25.53 s; first eclipse 12.7 likely a typo for 2.17,Sequence flash 0.33 s differs from Duration of Flash 0.52 Sec,Panels printed as '3 to 60° each',Tower height '18.3' printed without unit,Geographical range blank)</SimpleData>
		<SimpleData name="equip_years">{ }</SimpleData>
		<SimpleData name="equip_since">{ }</SimpleData>
		<SimpleData name="tenders">(3:2544,1795,1787)</SimpleData>
		<SimpleData name="photo_credit">DGLL</SimpleData>
