		<SimpleData name="tower_h_m">6</SimpleData>
		<SimpleData name="tower_colour">White - Black three strips</SimpleData>
		<SimpleData name="tower_year">1988</SimpleData>
		<SimpleData name="established">1934</SimpleData>
		<SimpleData name="visit">closed</SimpleData>
		<SimpleData name="tourism">0</SimpleData>
		<SimpleData name="museum">0</SimpleData>
		<SimpleData name="record">1</SimpleData>
		<SimpleData name="ledger_url">https://www.dgll.nic.in/sites/default/files/2022-12/Master%20Ledger%20Gandhidham%2020.pdf</SimpleData>
		<SimpleData name="page_url">https://www.dgll.nic.in/DGLL-light-house-location/about-vts-gandhi-dham/chank-tapu-lighthouse</SimpleData>
		<SimpleData name="rowlett">1988 (station established 1934). Active; focal plane 14 m (46 ft); white flash every 15 s. 8 m (26 ft) square cylindrical skeletal tower with gallery, mounted on a large square concrete base. Wikimapia has an older photo and Bing has a satellite view. Lighthouse painted white; the small lantern is red. A stone daybeacon was placed on the reef in 1885; a skeletal tower was added in 1928 but apparently it was not lighted until 1934. Located at the northeastern end of the extensive Chanka Reef system, about 35 km (2 mi) east northeast of Okha. Accessible only by boat. Site and tower closed. Admiralty F0386; NGA 28332.</SimpleData>
		<SimpleData name="photo">https://www.dgll.nic.in/sites/default/files/2022-11/Chank_Tapu_Lighthouse.png</SimpleData>
		<SimpleData name="transcribed">1</SimpleData>
		<SimpleData name="ledger_issues">(3:Height given as '6 Meter steel trestle above 3mtrs masonry structure',Date of commissioning lists '05.02.2022 for New Light and new trestle' and '23.05.2014'; 2014 used as established year,Intensity given as 'Max. Beam Intensity 10,000 Candela')</SimpleData>
		<SimpleData name="equip_years">{ }</SimpleData>
		<SimpleData name="equip_since">{ }</SimpleData>
		<SimpleData name="tenders">(0:)</SimpleData>
		<SimpleData name="photo_credit">DGLL</SimpleData>
	</SchemaData></ExtendedData>
