		<SimpleData name="tower_colour">Black and White Bands 3 Nos. of 4.9 m each (2 Black + 1 White), Bottom band: Black</SimpleData>
		<SimpleData name="tower_year">1965</SimpleData>
		<SimpleData name="established">1867</SimpleData>
