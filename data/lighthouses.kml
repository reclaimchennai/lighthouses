	<name>Koteshwar Lighthouse &amp; VTS station</name>
	<ExtendedData><SchemaData schemaUrl="#lighthouses">
		<SimpleData name="id">koteshwar-lighthouse-vts-station</SimpleData>
		<SimpleData name="kind">lighthouse</SimpleData>
		<SimpleData name="region">Gandhidham (VTS)</SimpleData>
		<SimpleData name="pos_src">DGLL ledger</SimpleData>
		<SimpleData name="alol">F-0354</SimpleData>
		<SimpleData name="char">Fl (2)W15 sec [(fl 1s, ec 3s), fl 1s, ec10s]</SimpleData>
		<SimpleData name="ckind">Fl</SimpleData>
		<SimpleData name="colour">W</SimpleData>
		<SimpleData name="group">2</SimpleData>
		<SimpleData name="period">15</SimpleData>
		<SimpleData name="phases">(4:1,3,1,10)</SimpleData>
		<SimpleData name="phases_src">ledger</SimpleData>
		<SimpleData name="flash_s">1</SimpleData>
		<SimpleData name="sectored">0</SimpleData>
		<SimpleData name="lum_nm">18</SimpleData>
		<SimpleData name="geo_nm">19.4</SimpleData>
		<SimpleData name="iala_nm">19.5</SimpleData>
		<SimpleData name="reach_nm">18</SimpleData>
		<SimpleData name="intensity_cd">94400</SimpleData>
		<SimpleData name="elev_m">50.3</SimpleData>
		<SimpleData name="optic">flasher</SimpleData>
		<SimpleData name="optic_evidence">Type of Light (LED Flasher); Type of Light structure: Stationary LED flashing light</SimpleData>
		<SimpleData name="optic_make">Sealite, Australia</SimpleData>
		<SimpleData name="optic_model">SL300-1D5-1-W</SimpleData>
		<SimpleData name="optic_type">LED Flasher</SimpleData>
		<SimpleData name="optic_size">373mm lens diameter</SimpleData>
		<SimpleData name="led">1</SimpleData>
		<SimpleData name="solar">1</SimpleData>
		<SimpleData name="ais">0</SimpleData>
		<SimpleData name="dgps">0</SimpleData>
		<SimpleData name="vts">1</SimpleData>
		<SimpleData name="tower_type">RCC Circular concrete Tower</SimpleData>
		<SimpleData name="tower_h_m">60</SimpleData>
		<SimpleData name="tower_colour">4 black and 3 white bands. (Bottom band black)</SimpleData>
		<SimpleData name="tower_year">2014</SimpleData>
		<SimpleData name="established">2014</SimpleData>
		<SimpleData name="visit">grounds</SimpleData>
		<SimpleData name="tourism">0</SimpleData>
		<SimpleData name="museum">0</SimpleData>
		<SimpleData name="record">1</SimpleData>
		<SimpleData name="ledger_url">https://www.dgll.nic.in/sites/default/files/2022-11/Koteshwar_0.pdf</SimpleData>
		<SimpleData name="page_url">https://www.dgll.nic.in/DGLL-light-house-location/about-vts-gandhi-dham/koteshwar-lighthouse-vts-station</SimpleData>
		<SimpleData name="rowlett">2014 (?). Active; focal plane 60 m (197 ft); two white flashes every 15 s. Approx. 57 m (187 ft) round cylindrical concrete tower with lantern and gallery, painted with black and white horizontal bands. Jay Thakker has a 2023 photo, Tanmay Vora has a photo, Lightphotos.net has a photo, and Google has a satellite view. This is both the northernmost and the westernmost lighthouse of India. It has strategic value, standing to the east of the disputed Rann of Kutch area on the Pakistani frontier. Located on the south side of the village of Koteshwar facing the inlet known as Kori Creek. Site open, tower closed. Admiralty F0354; NGA 28420.5.</SimpleData>
		<SimpleData name="photo">https://www.dgll.nic.in/sites/default/files/2022-09/Koteshwar%201.png</SimpleData>
		<SimpleData name="transcribed">1</SimpleData>
		<SimpleData name="ledger_issues">(4:Elevation given as sum '46.5+3.8=50.3 M',Vertical divergence stated only as '&gt;1.5°',Physical characteristic values are misaligned with their labels on page 1 (e.g. lens diameter/height/width rows shifted),No RACON/NAIS/DGPS sections; page numbering reads 'Page 9 of 8')</SimpleData>
		<SimpleData name="equip_years">{ }</SimpleData>
		<SimpleData name="equip_since">{ }</SimpleData>
		<SimpleData name="tenders">(1:2303)</SimpleData>
		<SimpleData name="photo_credit">DGLL</SimpleData>
	</SchemaData></ExtendedData>
      <Point><coordinates>68.53,23.68433</coordinates></Point>
