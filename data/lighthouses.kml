		<SimpleData name="equip_since">{ &quot;racon&quot;: { &quot;year&quot;: 2018, &quot;src&quot;: &quot;ledger&quot; }, &quot;ais&quot;: { &quot;year&quot;: 2017, &quot;src&quot;: &quot;ledger&quot; }, &quot;dgps&quot;: { &quot;year&quot;: 2003, &quot;src&quot;: &quot;network&quot; } }</SimpleData>
