		<SimpleData name="equip_since">{ &quot;racon&quot;: { &quot;year&quot;: 2004, &quot;src&quot;: &quot;network&quot; }, &quot;ais&quot;: { &quot;year&quot;: 2012, &quot;src&quot;: &quot;ledger&quot; }, &quot;dgps&quot;: { &quot;year&quot;: 2019, &quot;src&quot;: &quot;ledger&quot; } }</SimpleData>
