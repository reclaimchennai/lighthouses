  <Placemark>
	<name>Jakhau Lighthouse and Vts Station</name>
	<ExtendedData><SchemaData schemaUrl="#lighthouses">
		<SimpleData name="id">jakhau-lighthouse-and-vts-station</SimpleData>
		<SimpleData name="kind">lighthouse</SimpleData>
		<SimpleData name="region">Gandhidham (VTS)</SimpleData>
		<SimpleData name="pos_src">DGLL ledger</SimpleData>
		<SimpleData name="address">Jakhau Lighthouse &amp; VTS Station, PO- Jakhau, Taluka – Abdasa Distt. Kutch Gujarat – 370640</SimpleData>
		<SimpleData name="alol">F 0355</SimpleData>
		<SimpleData name="char">Fl W 10 sec. (0.3 flash+9.7eclipse =10 sec.)</SimpleData>
		<SimpleData name="ckind">Fl</SimpleData>
		<SimpleData name="colour">W</SimpleData>
		<SimpleData name="group">1</SimpleData>
		<SimpleData name="period">10</SimpleData>
		<SimpleData name="phases">(2:0.3,9.699999999999999)</SimpleData>
		<SimpleData name="phases_src">ledger</SimpleData>
		<SimpleData name="flash_s">0.3</SimpleData>
		<SimpleData name="sectored">0</SimpleData>
		<SimpleData name="lum_nm">17</SimpleData>
		<SimpleData name="geo_nm">18</SimpleData>
		<SimpleData name="reach_nm">17</SimpleData>
		<SimpleData name="elev_m">46</SimpleData>
		<SimpleData name="optic">revolving</SimpleData>
		<SimpleData name="optic_order">3</SimpleData>
		<SimpleData name="optic_evidence">375mm (3rd order small) revolving type; Rotation device: electrically operated stepper motor; R.P.M 2</SimpleData>
		<SimpleData name="optic_make">Stone chance</SimpleData>
		<SimpleData name="optic_type">revolving type</SimpleData>
		<SimpleData name="optic_size">375mm</SimpleData>
		<SimpleData name="rpm">2</SimpleData>
		<SimpleData name="panels">3</SimpleData>
		<SimpleData name="led">1</SimpleData>
		<SimpleData name="solar">1</SimpleData>
		<SimpleData name="ais">1</SimpleData>
		<SimpleData name="dgps">0</SimpleData>
		<SimpleData name="racon">M</SimpleData>
		<SimpleData name="vts">1</SimpleData>
		<SimpleData name="tower_type">Double shell RCC Circular tower</SimpleData>
		<SimpleData name="tower_h_m">41</SimpleData>
		<SimpleData name="tower_colour">4 red and 3 white bands (Band width 5.6 mtrs, bottom band red, nos. of bands - 7)</SimpleData>
		<SimpleData name="tower_year">1965</SimpleData>
		<SimpleData name="established">1957</SimpleData>
		<SimpleData name="visit">grounds</SimpleData>
		<SimpleData name="tourism">0</SimpleData>
		<SimpleData name="museum">0</SimpleData>
		<SimpleData name="record">1</SimpleData>
		<SimpleData name="ledger_url">https://www.dgll.nic.in/sites/default/files/2022-12/Master%20Ledger%20Gandhidham%2003.pdf</SimpleData>
		<SimpleData name="page_url">https://www.dgll.nic.in/DGLL-light-house-location/about-vts-gandhidham/jakhau-lighthouse-and-vts-station</SimpleData>
		<SimpleData name="rowlett">1965 (station established 1957). Active; focal plane 46 m (151 ft); white flash every 10 s. 41 m (135 ft) round cylindrical concrete tower with lantern and gallery, painted with horizontal red and white bands. Prashant Chauhan's 2024 photo is at right, Chandrakant Swain has a 2018 photo, DGLL has a photo of the 60 m (197 ft) traffic control tower that stands next to the lighthouse, Chandrakant Swain has a photo of both towers, and Google has a satellite view. The original lighthouse here was replaced in 1964. Located on the main quay of Jakhau, a fishing port in western Kachchh. Site open, tower closed. ARLHS IND-138; Admiralty F0355; NGA 28420.</SimpleData>
		<SimpleData name="arlhs">IND-138</SimpleData>
		<SimpleData name="photo">https://www.dgll.nic.in/sites/default/files/2022-11/Jakhau%20Lighthouseand%20Vts%20Station.png</SimpleData>
		<SimpleData name="transcribed">1</SimpleData>
		<SimpleData name="ledger_issues">(3:Position printed with seconds marks (23°14.36&quot;, 68°36.43&quot;) but values read as decimal minutes,Year of lighthouse commissioned 1957, but Date of Commissioning given as 1st April 1965 (Lighthouse),Off-grid solar system stated as non-operational)</SimpleData>
		<SimpleData name="equip_years">{ &quot;racon&quot;: 2004 }</SimpleData>
		<SimpleData name="equip_since">{ &quot;racon&quot;: { &quot;year&quot;: 2004, &quot;src&quot;: &quot;ledger&quot; }, &quot;ais&quot;: { &quot;year&quot;: 2012, &quot;src&quot;: &quot;network&quot; } }</SimpleData>
		<SimpleData name="tenders">(1:2303)</SimpleData>
		<SimpleData name="photo_credit">DGLL</SimpleData>
	</SchemaData></ExtendedData>
      <Point><coordinates>68.60717,23.23933</coordinates></Point>
