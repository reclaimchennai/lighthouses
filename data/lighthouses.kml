		<SimpleData name="transcribed">1</SimpleData>
		<SimpleData name="ledger_issues">(2:Divergence gives two values both labelled vertical ('4° 0.54'' and '0°41''), presumably main and emergency; no horizontal value,RACON section is a blank table)</SimpleData>
