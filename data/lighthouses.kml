		<SimpleData name="ledger_url">https://www.dgll.nic.in/sites/default/files/2022-12/Master%20Ledger%20Goa%2003_0.pdf</SimpleData>
		<SimpleData name="page_url">https://www.dgll.nic.in/DGLL-light-house-location/about-goa/vengurla-point-lighthouse</SimpleData>
		<SimpleData name="rowlett">1968 (station established 1869). Active; focal plane 82 m (269 ft); red flash every 5 s.13 m (43 ft) hexagonal cylindrical masonry tower with lantern and gallery, attached to a 1-story keeper's house. Lighthouse painted with black and white horizontal bands; lantern dome painted red. Kedar Sule contributed a 2007 photo , Lisbon Rebello has a closeup photo, Sushant Dabholkar has a 2023 closeup, Rinat Khairetdinov has a 2019 closeup, and Google has a satellite view. Located atop a seaside bluff at Vengurla. Accessible by road. Site open, tower open daily 4 to 5:30 pm. . ARLHS IND-120; Admiralty F0600; NGA 27800.</SimpleData>
		<SimpleData name="arlhs">IND-120</SimpleData>
		<SimpleData name="photo">https://www.dgll.nic.in/sites/default/files/2022-11/VENGURLA%20POINT%20LIGHTHOUSE.jpg</SimpleData>
		<SimpleData name="transcribed">1</SimpleData>
		<SimpleData name="ledger_issues">(4:Position and divergence use '*' in place of the degree sign,3 lenses at 3 RPM gives a flash every 6.67 s, not every 5 s,RACON section lists only Sr. No 6295 with all other fields blank (same serial appears in other ledgers),Also hosts a Danphone NAVTEX transmitter (518/490 kHz, ID 'J', 2015))</SimpleData>
		<SimpleData name="equip_years">{ &quot;ais&quot;: 2015 }</SimpleData>
		<SimpleData name="equip_since">{ &quot;navtex&quot;: { &quot;year&quot;: 2015, &quot;src&quot;: &quot;network&quot; }, &quot;ais&quot;: { &quot;year&quot;: 2015, &quot;src&quot;: &quot;ledger&quot; } }</SimpleData>
		<SimpleData name="tenders">(1:1897)</SimpleData>
		<SimpleData name="photo_credit">DGLL</SimpleData>
	</SchemaData></ExtendedData>
