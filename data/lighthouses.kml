		<SimpleData name="tower_type">Square Masonry Tower</SimpleData>
		<SimpleData name="tower_h_m">19</SimpleData>
		<SimpleData name="tower_colour">Black &amp; White bands</SimpleData>
		<SimpleData name="tower_year">1957</SimpleData>
		<SimpleData name="established">1874</SimpleData>
		<SimpleData name="visit">closed</SimpleData>
