		<SimpleData name="transcribed">1</SimpleData>
		<SimpleData name="ledger_issues">(2:Date of commissioning given as June 1998, which matches the DGPS commissioning date (05.06.1998); optic installation date printed as 'se1976',Effective beam intensity left blank)</SimpleData>
